// Copy this file to secrets.h and fill in the values.
// secrets.h is gitignored. Never commit it.
//
// Run tools/get_refresh_token.py to generate the two Spotify lines.

#pragma once

#define WIFI_SSID             "your-network"
#define WIFI_PASSWORD         "your-password"

// Your client id and secret, base64 encoded as "id:secret".
// The helper script prints this ready to paste.
#define SPOTIFY_BASIC_AUTH    "paste-from-helper-script"

// Long-lived. Does not expire unless you revoke it.
#define SPOTIFY_REFRESH_TOKEN "paste-from-helper-script"
